{
  "name": "israel-hikes",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "UPSTREAM", "class_name": "UpstreamGateway" }, {"name":"CONTACT","class_name":"ContactGateway"}],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UpstreamGateway"] }, {"tag":"v2","new_sqlite_classes":["ContactGateway"]},{"tag":"v3","new_sqlite_classes":["AdminAuthGateway"]},{"tag":"v4-remove-admin-auth","deleted_classes":["AdminAuthGateway"]}],
  "vars": {
    "NOMINATIM_URL": "https://nominatim.openstreetmap.org",
    "OSRM_URL": "https://router.project-osrm.org",
    "SERVICE_ENABLED": "true",
    "CONTACT_ENABLED":"true",
    "TURNSTILE_SITE_KEY":"0x4AAAAAAFSJ_s55yp2kS7m6",
    "CONTACT_HOSTNAME":"israel-hikes.amikamsnir.workers.dev",
  },
}
