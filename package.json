{
  "name": "israel-hikes",
  "version": "1.0.0",
  "description": "Hebrew RTL trail directory with source-linked route data and responsible planning tools",
  "main": "index.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "deploy": "wrangler deploy",
    "validate": "node scripts/validate-data.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:e2e": "node scripts/critical-ui-test.mjs && node scripts/i18n-test.mjs && node scripts/contact-ui-test.mjs && node scripts/user-journey-test.mjs && node scripts/inbox-ui-test.mjs",
    "test:a11y": "node scripts/accessibility-test.mjs",
    "check": "npm run validate && npm run test:unit && npm run build && npm run test:e2e && npm run test:a11y",
    "trail": "node scripts/trail.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fontsource/heebo": "^5.3.0",
    "i18next": "^26.4.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  },
  "private": true,
  "type": "module"
}
