{
  "name": "israel-hikes",
  "version": "1.0.0",
  "description": "Hebrew RTL trail directory with source-linked route data and responsible planning tools",
  "main": "index.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "deploy": "wrangler deploy",
    "validate": "node scripts/validate-data.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:e2e": "node scripts/critical-ui-test.mjs && node scripts/i18n-test.mjs && node scripts/contact-ui-test.mjs && node scripts/user-journey-test.mjs && node scripts/inbox-ui-test.mjs && node scripts/drive-info-ui-test.mjs && node scripts/card-navigation-ui-test.mjs && node scripts/location-ui-test.mjs && node scripts/thumbnail-ui-test.mjs",
    "test:a11y": "node scripts/accessibility-test.mjs",
    "check": "npm run lint && npm run lint:css && npm run typecheck && npm run validate && npm run test:unit && npm run build && npm run test:e2e && npm run test:a11y",
    "trail": "node scripts/trail.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings 0"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fontsource/heebo": "^5.3.0",
    "i18next": "^26.4.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "worker-runtime-types": "npm:@cloudflare/workers-types@^5.20261009.1",
    "wrangler": "^4.149.0"
  },
  "private": true,
  "type": "module"
}
