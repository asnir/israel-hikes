{
  "name": "israel-hikes-preview",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "UPSTREAM", "class_name": "UpstreamGateway" }, {"name":"CONTACT","class_name":"ContactGateway"}, {"name":"ADMIN_AUTH","class_name":"AdminAuthGateway"}],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UpstreamGateway"] }, {"tag":"v2","new_sqlite_classes":["ContactGateway"]}, {"tag":"v3","new_sqlite_classes":["AdminAuthGateway"]}],
  "vars": {
    "ADMIN_AUTH_ENABLED":"false",
    "ADMIN_PASSWORD_ENABLED":"false",
    "ADMIN_LIFECYCLE_ENABLED":"false",
    "NOMINATIM_URL": "https://nominatim.openstreetmap.org",
    "OSRM_URL": "https://router.project-osrm.org",
    "SERVICE_ENABLED": "true",
    "CONTACT_ENABLED":"true",
    "TURNSTILE_SITE_KEY":"0x4AAAAAAFSJ_s55yp2kS7m6",
    "CONTACT_HOSTNAME":"israel-hikes-preview.amikamsnir.workers.dev",
  },
}
